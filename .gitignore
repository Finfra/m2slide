.env.production
.env.local
.env.*.local

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
/dist

# Gatsby files
.cache/
public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
# config.yml

# theme: default·default_lec·default_dark·_shared만 추적, 그 외 사용자 커스텀은 추적 제외
/theme/*
!/theme/default/
!/theme/default_lec/
!/theme/default_dark/
!/theme/_shared/

# data: .gitkeep + SSOT 템플릿만 추적, 그 외 사용자 데이터는 추적 제외
/data/*
!/data/.gitkeep
!/data/Info.template.md
!/data/component-libraries.yml
!/data/symbol-usage.yml
!/data/emoji-usage.yml
!/data/htmlart/
!/data/htmlart/**
!/data/palettes/
!/data/palettes/**
!/data/slot-designer/
!/data/slot-designer/**
!/data/ppt2m2slide/
!/data/ppt2m2slide/**
!/data/info-filler/
!/data/info-filler/**
!/data/agenda-designer/
!/data/agenda-designer/**
!/data/layout-selector/
!/data/layout-selector/**
!/data/md-builder/
!/data/md-builder/**
!/data/m2unity/
!/data/m2unity/**
!/data/note-writer/
!/data/note-writer/**
!/data/media-creater/
!/data/media-creater/**

# Backup files
*.bak

# Playwright MCP cache
.playwright-mcp/

# Python bytecode cache
__pycache__/

# 루트 직접 생성된 캡처/스크린샷 차단 (capture-output-rules.md)
# 모든 스크린샷·캡처 png 는 _doc_work/capture/ 에 저장해야 함
/*.png
/*.jpg
/*.jpeg
/*.webp

# 대용량 동영상은 git 미추적 — finfra.kr 서버 호스팅 참조 (Issue: deploy 아티팩트 경량화)
*.mp4

# ppt2m2slide 역변환 중간 산출물(raw-media·img-fullext·pptx2md-out) — 배포 자산 아님, 원본 pptx로 재생성 가능
**/_pipeline/

# refs/ 는 리서치 참고자료 스크랩 — 배포 자산 아님, git 미추적
Projects/*/refs/

# pdf 는 배포 산출물 아님(m2slide 는 html/epub 만 배포) — git 미추적
*.pdf

# epub 는 https://finfra.github.io/m2slide/ 에 실제 퍼블리싱되는 것만 추적.
# docs/ 미러에 없는 프로젝트의 epub 는 추적 제외
*.epub
!/Projects/m2Slide/slide/m2Slide.epub
!/Projects/m2Slide_MermaidExample/slide/*.epub
!/docs/m2Slide/m2Slide.epub
!/docs/m2Slide_MermaidExample/*.epub

# Projects_deck/ 는 독립 git repo (github.com/finfra/m2slide-deck) — embedded repo 회피.
# m2slide 본체는 이 폴더를 추적하지 않음. 설계: _doc_arch/deck-repo.md
Projects_deck/

# issue-map 산출물 (Issue.md 로부터 재생성 — prj1#Issue286)
Issue_map.htm

# graphify 산출물 — 재생성 가능, 커밋 루프 방지 (Issue296)
graphify-out/
