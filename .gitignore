# config.yml

# theme: default·default_lec·_shared만 추적, 그 외 사용자 커스텀은 추적 제외
/theme/*
!/theme/default/
!/theme/default_lec/
!/theme/_shared/

# data: .gitkeep + SSOT 템플릿만 추적, 그 외 사용자 데이터는 추적 제외
/data/*
!/data/.gitkeep
!/data/Info.template.md
!/data/component-libraries.yml
!/data/symbol-usage.yml
!/data/emoji-usage.yml
!/data/htmlart/
!/data/htmlart/**
!/data/palettes/
!/data/palettes/**
!/data/slot-designer/
!/data/slot-designer/**
!/data/ppt2m2slide/
!/data/ppt2m2slide/**
!/data/info-filler/
!/data/info-filler/**

# Backup files
*.bak

# 루트 직접 생성된 캡처/스크린샷 차단 (capture-output-rules.md)
# 모든 스크린샷·캡처 png 는 _doc_work/capture/ 에 저장해야 함
/*.png
/*.jpg
/*.jpeg
/*.webp
