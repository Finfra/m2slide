# Projects.md — Projects/.gitignore 를 구동하는 로컬 인덱스(SSOT). git 미추적 (Issue254)
# 폴더 스캔 + Projects/.gitignore publishing 시드로 `--sync-projects` 재생성 가능.
Projects.md

# vscode
.vscode

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

